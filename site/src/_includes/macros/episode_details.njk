<table class="episode-details">
    {% if params.episode %}
    <tr>
        <td class="label">Episode</td>
        <td>{{ params.episode }}</td>
    </tr>
    {% endif %}

    {% if params.title %}
    <tr>
        <td class="label">Title</td>
        <td>{{ params.title }}</td>
    </tr>
    {% endif %}

    {% if params.production %}
    <tr>
        <td class="label">Production #</td>
        <td>{{ params.production }}</td>
    </tr>
    {% endif %}

    {% if params.ukairdate %}
    <tr>
        <td class="label">UK Air Date</td>
        <td>{{ params.ukairdate }}</td>
    </tr>
    {% endif %}

    {% if params.usairdate %}
    <tr>
        <td class="label">US Air Date</td>
        <td>{{ params.usairdate }}</td>
    </tr>
    {% endif %}

    {% if params.length %}
    <tr>
        <td class="label">Length</td>
        <td>{{ params.length }}</td>
    </tr>
    {% endif %}
    {% if params.frames_img %}
    <tr class="frames">
        <td colspan="2">
        <a href="{{ params.frames_img }}"><img src="{{ params.frames_img }}" alt="Montage of episode frames" class="frames"></a>
        </td>
    </tr>
    {% endif %}
</table>
