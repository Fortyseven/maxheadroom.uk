{
    "name": "maxheadroomuk",
    "version": "1.0.0",
    "description": "A fan-sourced rebuild of maxheadroom.com",
    "main": "./index.html",
    "scripts": {
        "dev": "npm-run-all --parallel sass:watch eleventy:serve",
        "eleventy:serve": "eleventy --serve",
        "sass:watch": "sass --watch src/_scss/style.scss:src/css/style.css",
        "build": "eleventy"
    },
    "keywords": [
        "11ty",
        "11ty-starter",
        "eleventy",
        "eleventy-starter",
        "eleventy-sample",
        "11ty-template"
    ],
    "dependencies": {
        "@11ty/eleventy": "^0.11.1",
        "markdown-it": "^14.1.0",
        "markdown-it-attrs": "^4.3.1"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5",
        "sass": "^1.75.0"
    }
}
